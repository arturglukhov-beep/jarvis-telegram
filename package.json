{
  "name": "jarvis-telegram",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p '*_test.py'",
    "check": "node scripts/check-config.js --offline",
    "setup": "python3 scripts/setup.py",
    "metadata": "node scripts/check-config.js --codex-metadata"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "grammy": "1.43.0",
    "image-size": "2.1.0"
  }
}
